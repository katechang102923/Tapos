rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function storePath(storeId) {
      return /databases/$(database)/documents/stores/$(storeId);
    }

    function hasUserDoc() {
      return signedIn() && exists(userPath());
    }

    function userDoc() {
      return get(userPath());
    }

    function role() {
      return hasUserDoc() ? userDoc().data.role : null;
    }

    function approved() {
      return hasUserDoc() && userDoc().data.approved == true && userDoc().data.status == "active";
    }

    function userStoreId() {
      return hasUserDoc() ? userDoc().data.storeId : null;
    }

    function membershipRole(storeId) {
      return hasUserDoc()
        && userDoc().data.memberships is map
        && storeId in userDoc().data.memberships
        ? userDoc().data.memberships[storeId]
        : (
          hasUserDoc()
          && userDoc().data.storeRoles is map
          && storeId in userDoc().data.storeRoles
          ? userDoc().data.storeRoles[storeId]
          : null
        );
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.email == "ciut0000@gmail.com"
          || (
            hasUserDoc()
            && userDoc().data.role == "admin"
            && userDoc().data.approved == true
            && userDoc().data.status == "active"
          )
        );
    }

    function isOwner(storeId) {
      return signedIn() && approved() && ((userStoreId() == storeId && role() in ["merchant", "owner"]) || membershipRole(storeId) == "owner");
    }

    function ownsStoreDoc(storeId) {
      return signedIn()
        && exists(storePath(storeId))
        && get(storePath(storeId)).data.ownerId == request.auth.uid;
    }

    function canManageStore(storeId) {
      return isAdmin() || isOwner(storeId) || membershipRole(storeId) == "manager" || ownsStoreDoc(storeId);
    }

    function canHandleOrders(storeId) {
      return signedIn()
        && (
          isAdmin()
          || membershipRole(storeId) in ["owner", "manager", "staff"]
          || (approved() && userStoreId() == storeId && role() in ["merchant", "kitchen", "owner", "manager", "staff"])
        );
    }

    function canViewStoreData(storeId) {
      return isAdmin() || canHandleOrders(storeId) || membershipRole(storeId) == "viewer";
    }

    function validOrderCounterWrite() {
      return request.resource.data.keys().hasOnly(["qr", "pos", "kiosk"])
        && (!("qr" in request.resource.data) || request.resource.data.qr is number)
        && (!("pos" in request.resource.data) || request.resource.data.pos is number)
        && (!("kiosk" in request.resource.data) || request.resource.data.kiosk is number);
    }

    function canWriteCashFlow(storeId) {
      return isAdmin()
        || membershipRole(storeId) in ["owner", "manager", "staff"]
        || (approved() && userStoreId() == storeId && role() in ["merchant", "owner"]);
    }

    function validOrderStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt", "rejectReason", "cancelReason"])
        && request.resource.data.status in ["pending", "waiting", "unprocessed", "accepted", "cooking", "preparing", "ready", "completed", "cancelled"];
    }

    function validOwnerUserCreate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.email is string
        && request.resource.data.name is string
        && (
          (
            request.resource.data.email == "ciut0000@gmail.com"
            && request.resource.data.role == "admin"
            && request.resource.data.approved == true
            && request.resource.data.status == "active"
          )
          || (
            request.resource.data.role == "user"
            && request.resource.data.approved == false
            && request.resource.data.status == "pending"
          )
        );
    }

    function validOwnProfileUpdate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && resource.data.id == request.resource.data.id
        && resource.data.email == request.resource.data.email
        && (
          (
            resource.data.role == request.resource.data.role
            && resource.data.storeId == request.resource.data.storeId
          )
          || (
            resource.data.storeId == null
            && resource.data.role == "user"
            && request.resource.data.storeId is string
            && request.resource.data.role in ["merchant", "owner", "manager", "staff", "viewer"]
            && ownsStoreDoc(request.resource.data.storeId)
          )
        );
    }

    function validOrderCreateCommon() {
      return request.resource.data.storeId is string
        && exists(storePath(request.resource.data.storeId))
        && request.resource.data.items is list
        && request.resource.data.total is number
        && request.resource.data.totalAmount is number
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.source in ["qr", "pos", "kiosk"];
    }

    function validQrOrderCreate() {
      return validOrderCreateCommon()
        && request.resource.data.source == "qr"
        && (
          request.resource.data.status == "pending"
          || (
            request.resource.data.status == "cancelled"
            && request.resource.data.cancelReason is string
          )
        )
        && request.resource.data.customerSessionId is string;
    }

    function validPosOrderCreate() {
      return validOrderCreateCommon()
        && request.resource.data.source in ["pos", "kiosk"]
        && request.resource.data.status in ["pending", "accepted"]
        && signedIn()
        && canHandleOrders(request.resource.data.storeId);
    }

    function validNestedOrderCreateCommon(storeId) {
      return request.resource.data.storeId == storeId
        && request.resource.data.items is list
        && request.resource.data.total is number
        && request.resource.data.createdAt is string
        && request.resource.data.source in ["qr", "pos", "kiosk"]
        && request.resource.data.keys().hasOnly([
          "id",
          "storeId",
          "mode",
          "tableNo",
          "tableName",
          "tableNumber",
          "customerName",
          "customerPhone",
          "customerSessionId",
          "customerNote",
          "archiveEligible",
          "archivedAt",
          "note",
          "memberId",
          "memberPhone",
          "memberName",
          "customer",
          "items",
          "total",
          "totalAmount",
          "orderType",
          "source",
          "status",
          "queueNumber",
          "orderNumber",
          "pickupNumber",
          "createdAt",
          "updatedAt",
          "promotionDiscounts",
          "orderDiscount",
          "discountSummary",
          "pointsEarned",
          "pointsUsed",
          "storedValueUsed",
          "couponId",
          "couponTitle",
          "couponDiscountAmount",
          "paymentMethod",
          "cancelReason",
          "rejectReason"
        ]);
    }

    function validNestedQrOrderCreate(storeId) {
      return validNestedOrderCreateCommon(storeId)
        && request.resource.data.source == "qr"
        && (
          request.resource.data.status == "pending"
          || (
            request.resource.data.status == "cancelled"
            && request.resource.data.cancelReason is string
          )
        );
    }

    function validNestedPosOrderCreate(storeId) {
      return validNestedOrderCreateCommon(storeId)
        && request.resource.data.source in ["pos", "kiosk"]
        && request.resource.data.status in ["pending", "accepted"]
        && canHandleOrders(storeId);
    }

    function validQrMemberCreate(storeId) {
      return request.resource.data.storeId == storeId
        && request.resource.data.phone is string
        && request.resource.data.name is string
        && request.resource.data.keys().hasOnly([
          "id",
          "storeId",
          "memberNo",
          "name",
          "phone",
          "email",
          "birthday",
          "note",
          "points",
          "balance",
          "storedValueBalance",
          "totalSpent",
          "totalOrders",
          "lastOrderAt",
          "createdAt",
          "updatedAt",
          "createdBy"
        ]);
    }

    function validQrMemberSelfUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "phone", "email", "birthday", "updatedAt"]);
    }

    function canTopupStoredValue(storeId) {
      return isAdmin()
        || membershipRole(storeId) in ["owner", "manager"]
        || (
          hasUserDoc()
          && userDoc().data.topupStoreIds is list
          && storeId in userDoc().data.topupStoreIds
        );
    }

    function canManageMembers(storeId) {
      return isAdmin()
        || membershipRole(storeId) in ["owner", "manager"]
        || (approved() && userStoreId() == storeId && role() in ["merchant", "owner"]);
    }

    function canLookupMembers(storeId) {
      return isAdmin()
        || membershipRole(storeId) in ["owner", "manager", "staff"]
        || (approved() && userStoreId() == storeId && role() in ["merchant", "owner"]);
    }

    function storeHasMemberEnabled(storeId) {
      return exists(storePath(storeId))
        && get(storePath(storeId)).data.features is map
        && get(storePath(storeId)).data.features.memberEnabled == true;
    }

    function storeHasStoredValueEnabled(storeId) {
      return exists(storePath(storeId))
        && get(storePath(storeId)).data.features is map
        && get(storePath(storeId)).data.features.memberStoredValueEnabled == true;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin() || resource.data.email == request.auth.token.email);
      allow create: if validOwnerUserCreate(userId) || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /stores/{storeId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin();
      // owners/managers can update store fields, but NOT the features block (e.g. kdsEnabled)
      allow update: if isAdmin()
        || (canManageStore(storeId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["features"]));
      allow delete: if isAdmin();
    }

    match /stores/{storeId}/orders/{orderId} {
      // QR customers use direct document listeners after creating an order.
      // Allow get on QR orders, but never allow anonymous list over a store's orders.
      allow get: if isAdmin() || canViewStoreData(storeId) || resource.data.source == "qr";
      allow list: if isAdmin() || canViewStoreData(storeId);
      allow create: if validNestedQrOrderCreate(storeId) || validNestedPosOrderCreate(storeId) || isAdmin();
      allow update: if isAdmin() || (canHandleOrders(storeId) && validOrderStatusUpdate());
      allow delete: if isAdmin();
    }

    match /stores/{storeId}/members/{memberId} {
      // POS can list/query members. QR can create a member and read a single member doc,
      // but cannot list the full member database.
      allow get: if canLookupMembers(storeId) || resource.data.phone is string;
      allow list: if canLookupMembers(storeId) || request.query.limit <= 1;
      allow create: if validQrMemberCreate(storeId) || (canLookupMembers(storeId) && validQrMemberCreate(storeId));
      allow update: if (
          canLookupMembers(storeId)
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(["storedValueBalance", "balance", "points"])
            || canTopupStoredValue(storeId)
            || canHandleOrders(storeId)
          )
        )
        || validQrMemberSelfUpdate()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["points", "updatedAt"])
          && request.resource.data.points is number
          && request.resource.data.points <= resource.data.points
        );
      allow delete: if isAdmin();
    }

    match /stores/{storeId}/optionGroups/{groupId} {
      allow read: if isAdmin()
        || canViewStoreData(storeId)
        || (resource.data.storeId is string && resource.data.options is list && resource.data.options.size() > 0);
      allow create, update, delete: if isAdmin()
        || (approved() && userStoreId() == storeId && role() in ["merchant", "owner", "manager", "staff"])
        || membershipRole(storeId) in ["owner", "manager", "staff"];
    }

    match /stores/{storeId}/settings/memberRules {
      allow read: if true;
      allow create, update, delete: if isAdmin() || membershipRole(storeId) in ["owner", "manager"];
    }

    match /stores/{storeId}/rewardCoupons/{couponId} {
      allow get, list: if resource.data.enabled == true || canViewStoreData(storeId);
      allow create, update, delete: if isAdmin() || membershipRole(storeId) in ["owner", "manager"];
    }

    match /stores/{storeId}/memberCoupons/{memberCouponId} {
      allow get: if canViewStoreData(storeId) || resource.data.memberId is string;
      allow list: if canViewStoreData(storeId) || request.query.limit <= 20;
      allow create: if request.resource.data.storeId == storeId
        && request.resource.data.memberId is string
        && request.resource.data.status == "unused";
      allow update: if canHandleOrders(storeId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /stores/{storeId}/memberTransactions/{transactionId} {
      allow read: if canLookupMembers(storeId);
      allow create: if request.resource.data.storeId == storeId
        && request.resource.data.customerId is string
        && request.resource.data.amount is number
        && request.resource.data.type in ["topup", "payment", "spend", "adjust", "refund", "points_add", "points_use"]
        && (
          (request.resource.data.type == "topup" && (canTopupStoredValue(storeId) || canHandleOrders(storeId)))
          || (request.resource.data.type in ["payment", "spend"] && canHandleOrders(storeId))
          || (request.resource.data.type in ["adjust", "refund", "points_add"] && canTopupStoredValue(storeId))
          || request.resource.data.type == "points_use"
        );
      allow update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create: if request.resource.data.storeId is string
        && canManageStore(request.resource.data.storeId);
      allow update, delete: if resource.data.storeId is string
        && canManageStore(resource.data.storeId);
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if request.resource.data.storeId is string
        && canManageStore(request.resource.data.storeId);
      allow update, delete: if resource.data.storeId is string
        && canManageStore(resource.data.storeId);
    }

    match /devices/{deviceId} {
      allow read: if isAdmin() || (resource.data.storeId is string && membershipRole(resource.data.storeId) in ["owner", "manager", "staff", "viewer"]);
      allow create: if request.resource.data.storeId is string
        && (isAdmin() || membershipRole(request.resource.data.storeId) in ["owner", "manager"]);
      allow update, delete: if resource.data.storeId is string
        && (isAdmin() || membershipRole(resource.data.storeId) in ["owner", "manager"]);
    }

    match /tables/{tableId} {
      allow read: if true;
      allow create: if request.resource.data.storeId is string
        && (isAdmin() || membershipRole(request.resource.data.storeId) in ["owner", "manager"]);
      allow update, delete: if resource.data.storeId is string
        && (isAdmin() || membershipRole(resource.data.storeId) in ["owner", "manager"]);
    }

    match /cashFlows/{cashFlowId} {
      allow read: if resource.data.storeId is string && canViewStoreData(resource.data.storeId);
      allow create: if request.resource.data.storeId is string
        && request.resource.data.itemId is string
        && request.resource.data.itemName is string
        && request.resource.data.type in ["income", "expense"]
        && request.resource.data.amount is number
        && request.resource.data.createdAt is string
        && canWriteCashFlow(request.resource.data.storeId);
      allow update, delete: if resource.data.storeId is string
        && (isAdmin() || membershipRole(resource.data.storeId) in ["owner", "manager"]);
    }

    match /cashFlowItems/{itemId} {
      allow read: if resource.data.storeId is string && canViewStoreData(resource.data.storeId);
      allow create: if request.resource.data.storeId is string
        && request.resource.data.name is string
        && request.resource.data.type in ["income", "expense"]
        && request.resource.data.amountMode in ["open", "fixed"]
        && canManageStore(request.resource.data.storeId);
      allow update, delete: if resource.data.storeId is string
        && canManageStore(resource.data.storeId);
    }

    match /orders/{orderId} {
      allow get: if isAdmin() || canHandleOrders(resource.data.storeId) || (resource.data.customerSessionId is string);
      // list: Must be authenticated. Firestore security rules cannot verify query filters,
      // so we enforce this in frontend queries and backend admin checks.
      // - Admin can list all orders
      // - Staff/Owner/Viewer must have canViewStoreData permission (enforced via scoped queries in client code)
      allow list: if signedIn();
      allow create: if validQrOrderCreate() || validPosOrderCreate() || isAdmin();
      allow update: if isAdmin() || (canHandleOrders(resource.data.storeId) && validOrderStatusUpdate());
      allow delete: if isAdmin();
    }

    match /dailyReports/{reportId} {
      allow read: if isAdmin()
        || (resource.data.storeId is string && (
          membershipRole(resource.data.storeId) in ["owner", "manager", "viewer"]
          || (approved() && userStoreId() == resource.data.storeId && role() in ["merchant", "owner"])
        ));
      allow create, update: if isAdmin()
        || (request.resource.data.storeId is string && (
          membershipRole(request.resource.data.storeId) in ["owner", "manager"]
          || (approved() && userStoreId() == request.resource.data.storeId && role() in ["merchant", "owner"])
        ));
      allow delete: if isAdmin();
    }

    match /promotions/{promotionId} {
      allow read: if true;
      allow create: if request.resource.data.storeId is string
        && canManageStore(request.resource.data.storeId);
      allow update, delete: if resource.data.storeId is string
        && canManageStore(resource.data.storeId);
    }

    match /pendingInvites/{inviteId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /pendingUsers/{pendingUserId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /storeUserBindings/{bindingId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /storeUsers/{bindingId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /platformNotifications/{notifId} {
      // Any signed-in user can create a registration notification (needed for onboarding)
      allow create: if signedIn()
        && request.resource.data.type == "store_registration"
        && request.resource.data.email is string
        && request.resource.data.storeName is string
        && request.resource.data.contactName is string
        && request.resource.data.phone is string
        && request.resource.data.read == false;
      // Only the platform admin can read, update (mark-read), or delete
      allow read, update, delete: if signedIn()
        && request.auth.token.email == "ciut0000@gmail.com";
    }

    match /customers/{customerId} {
      allow read: if resource.data.storeId is string
        && storeHasMemberEnabled(resource.data.storeId)
        && canLookupMembers(resource.data.storeId);
      allow create: if request.resource.data.storeId is string
        && storeHasMemberEnabled(request.resource.data.storeId)
        && canManageMembers(request.resource.data.storeId)
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.memberNo is string;
      allow update: if resource.data.storeId is string
        && storeHasMemberEnabled(resource.data.storeId)
        && (canManageMembers(resource.data.storeId) || canLookupMembers(resource.data.storeId));
      allow delete: if resource.data.storeId is string && isAdmin();
    }

    match /pointLogs/{logId} {
      allow read: if resource.data.storeId is string
        && canLookupMembers(resource.data.storeId);
      allow create: if request.resource.data.storeId is string
        && canLookupMembers(request.resource.data.storeId)
        && request.resource.data.customerId is string
        && request.resource.data.type in ["earn", "redeem", "adjust", "rollback"]
        && request.resource.data.points is number;
      allow update, delete: if isAdmin();
    }

    match /storedValueLogs/{logId} {
      allow read: if resource.data.storeId is string
        && canLookupMembers(resource.data.storeId);
      allow create: if request.resource.data.storeId is string
        && canLookupMembers(request.resource.data.storeId)
        && request.resource.data.customerId is string
        && request.resource.data.type in ["topup", "spend", "adjust", "refund"]
        && request.resource.data.amount is number;
      allow update, delete: if isAdmin();
    }

    match /counters/orderNumbers {
      allow read: if true;
      allow create: if isAdmin() || validOrderCounterWrite();
      allow update: if isAdmin() || (
        validOrderCounterWrite()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["qr", "pos", "kiosk"])
      );
      allow delete: if isAdmin();
    }

    match /counters/{counterId} {
      allow read, create, update, delete: if isAdmin();
    }
  }
}
