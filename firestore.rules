rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function storePath(storeId) {
      return /databases/$(database)/documents/stores/$(storeId);
    }

    function hasUserDoc() {
      return signedIn() && exists(userPath());
    }

    function userDoc() {
      return get(userPath());
    }

    function role() {
      return hasUserDoc() ? userDoc().data.role : null;
    }

    function userStoreId() {
      return hasUserDoc() ? userDoc().data.storeId : null;
    }

    function isAdmin() {
      return role() == "admin";
    }

    function isOwner(storeId) {
      return signedIn() && userStoreId() == storeId && role() == "owner";
    }

    function ownsStoreDoc(storeId) {
      return signedIn()
        && exists(storePath(storeId))
        && get(storePath(storeId)).data.ownerId == request.auth.uid;
    }

    function canManageStore(storeId) {
      return isAdmin() || isOwner(storeId) || ownsStoreDoc(storeId);
    }

    function canHandleOrders(storeId) {
      return signedIn()
        && userStoreId() == storeId
        && role() in ["owner", "staff", "kitchen"];
    }

    function validOwnerUserCreate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.storeId == null
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.role == "owner";
    }

    function validOwnerStoreCreate() {
      return signedIn()
        && role() == "owner"
        && userStoreId() == null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.isOpen is bool;
    }

    function validOwnProfileUpdate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && resource.data.id == request.resource.data.id
        && resource.data.email == request.resource.data.email
        && resource.data.role == request.resource.data.role
        && (
          resource.data.storeId == request.resource.data.storeId
          || (
            resource.data.storeId == null
            && request.resource.data.storeId is string
            && ownsStoreDoc(request.resource.data.storeId)
          )
        );
    }

    function validCustomerOrderCreate() {
      return request.resource.data.storeId is string
        && exists(storePath(request.resource.data.storeId))
        && request.resource.data.status == "new"
        && request.resource.data.items is list
        && request.resource.data.total is number
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if validOwnerUserCreate(userId) || isAdmin();
      allow update: if isAdmin() || validOwnProfileUpdate(userId);
      allow delete: if isAdmin();
    }

    match /stores/{storeId} {
      allow read: if true;
      allow create: if isAdmin() || validOwnerStoreCreate();
      allow update: if isAdmin() || ownsStoreDoc(storeId);
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create: if request.resource.data.storeId is string
        && canManageStore(request.resource.data.storeId);
      allow update, delete: if resource.data.storeId is string
        && canManageStore(resource.data.storeId);
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if request.resource.data.storeId is string
        && canManageStore(request.resource.data.storeId);
      allow update, delete: if resource.data.storeId is string
        && canManageStore(resource.data.storeId);
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || canHandleOrders(resource.data.storeId);
      allow create: if validCustomerOrderCreate();
      allow update: if isAdmin() || canHandleOrders(resource.data.storeId);
      allow delete: if isAdmin();
    }
  }
}
