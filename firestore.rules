rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function storePath(storeId) {
      return /databases/$(database)/documents/stores/$(storeId);
    }

    function hasUserDoc() {
      return signedIn() && exists(userPath());
    }

    function userDoc() {
      return get(userPath());
    }

    function role() {
      return hasUserDoc() ? userDoc().data.role : null;
    }

    function approved() {
      return hasUserDoc() && userDoc().data.approved == true && userDoc().data.status == "active";
    }

    function userStoreId() {
      return hasUserDoc() ? userDoc().data.storeId : null;
    }

    function membershipRole(storeId) {
      return hasUserDoc()
        && userDoc().data.memberships is map
        && storeId in userDoc().data.memberships
        ? userDoc().data.memberships[storeId]
        : (
          hasUserDoc()
          && userDoc().data.storeRoles is map
          && storeId in userDoc().data.storeRoles
          ? userDoc().data.storeRoles[storeId]
          : null
        );
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.email == "ciut0000@gmail.com"
          || (
            hasUserDoc()
            && userDoc().data.role == "admin"
            && userDoc().data.approved == true
            && userDoc().data.status == "active"
          )
        );
    }

    function isOwner(storeId) {
      return signedIn() && approved() && ((userStoreId() == storeId && role() in ["merchant", "owner"]) || membershipRole(storeId) == "owner");
    }

    function ownsStoreDoc(storeId) {
      return signedIn()
        && exists(storePath(storeId))
        && get(storePath(storeId)).data.ownerId == request.auth.uid;
    }

    function canManageStore(storeId) {
      return isAdmin() || isOwner(storeId) || membershipRole(storeId) == "manager" || ownsStoreDoc(storeId);
    }

    function canHandleOrders(storeId) {
      return signedIn()
        && approved()
        && ((userStoreId() == storeId && role() in ["merchant", "kitchen", "owner", "manager", "staff"]) || membershipRole(storeId) in ["owner", "manager", "staff"]);
    }

    function canViewStoreData(storeId) {
      return isAdmin() || canHandleOrders(storeId) || membershipRole(storeId) == "viewer";
    }

    function canWriteCashFlow(storeId) {
      return isAdmin() || membershipRole(storeId) in ["owner", "manager", "staff"];
    }

    function validOrderStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt", "rejectReason", "cancelReason"])
        && request.resource.data.status in ["pending", "waiting", "unprocessed", "accepted", "cooking", "preparing", "ready", "completed", "cancelled"];
    }

    function validOwnerUserCreate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.email is string
        && request.resource.data.name is string
        && (
          (
            request.resource.data.email == "ciut0000@gmail.com"
            && request.resource.data.role == "admin"
            && request.resource.data.approved == true
            && request.resource.data.status == "active"
          )
          || (
            request.resource.data.role == "user"
            && request.resource.data.approved == false
            && request.resource.data.status == "pending"
          )
        );
    }

    function validOwnProfileUpdate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && resource.data.id == request.resource.data.id
        && resource.data.email == request.resource.data.email
        && (
          (
            resource.data.role == request.resource.data.role
            && resource.data.storeId == request.resource.data.storeId
          )
          || (
            resource.data.storeId == null
            && resource.data.role == "user"
            && request.resource.data.storeId is string
            && request.resource.data.role in ["merchant", "owner", "manager", "staff", "viewer"]
            && ownsStoreDoc(request.resource.data.storeId)
          )
        );
    }

    function validOrderCreateCommon() {
      return request.resource.data.storeId is string
        && exists(storePath(request.resource.data.storeId))
        && request.resource.data.items is list
        && request.resource.data.total is number
        && request.resource.data.totalAmount is number
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.source in ["qr", "pos"];
    }

    function validQrOrderCreate() {
      return validOrderCreateCommon()
        && request.resource.data.source == "qr"
        && (
          request.resource.data.status == "pending"
          || (
            request.resource.data.status == "cancelled"
            && request.resource.data.cancelReason is string
          )
        )
        && request.resource.data.customerSessionId is string;
    }

    function validPosOrderCreate() {
      return validOrderCreateCommon()
        && request.resource.data.source == "pos"
        && request.resource.data.status in ["pending", "accepted"]
        && signedIn()
        && canHandleOrders(request.resource.data.storeId);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin() || resource.data.email == request.auth.token.email);
      allow create: if validOwnerUserCreate(userId) || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /stores/{storeId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || canManageStore(storeId);
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create: if request.resource.data.storeId is string
        && canManageStore(request.resource.data.storeId);
      allow update, delete: if resource.data.storeId is string
        && canManageStore(resource.data.storeId);
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if request.resource.data.storeId is string
        && canManageStore(request.resource.data.storeId);
      allow update, delete: if resource.data.storeId is string
        && canManageStore(resource.data.storeId);
    }

    match /devices/{deviceId} {
      allow read: if isAdmin() || (resource.data.storeId is string && membershipRole(resource.data.storeId) in ["owner", "manager", "staff", "viewer"]);
      allow create: if request.resource.data.storeId is string
        && (isAdmin() || membershipRole(request.resource.data.storeId) in ["owner", "manager"]);
      allow update, delete: if resource.data.storeId is string
        && (isAdmin() || membershipRole(resource.data.storeId) in ["owner", "manager"]);
    }

    match /tables/{tableId} {
      allow read: if true;
      allow create: if request.resource.data.storeId is string
        && (isAdmin() || membershipRole(request.resource.data.storeId) in ["owner", "manager"]);
      allow update, delete: if resource.data.storeId is string
        && (isAdmin() || membershipRole(resource.data.storeId) in ["owner", "manager"]);
    }

    match /cashFlows/{cashFlowId} {
      allow read: if resource.data.storeId is string && canViewStoreData(resource.data.storeId);
      allow create: if request.resource.data.storeId is string
        && request.resource.data.type in ["income", "expense"]
        && request.resource.data.amount is number
        && request.resource.data.category is string
        && request.resource.data.createdAt is string
        && canWriteCashFlow(request.resource.data.storeId);
      allow update, delete: if resource.data.storeId is string
        && (isAdmin() || membershipRole(resource.data.storeId) in ["owner", "manager"]);
    }

    match /orders/{orderId} {
      allow get: if isAdmin() || canHandleOrders(resource.data.storeId) || (resource.data.customerSessionId is string);
      allow list: if isAdmin() || canHandleOrders(resource.data.storeId);
      allow create: if validQrOrderCreate() || validPosOrderCreate() || isAdmin();
      allow update: if isAdmin() || (canHandleOrders(resource.data.storeId) && validOrderStatusUpdate());
      allow delete: if isAdmin();
    }

    match /pendingInvites/{inviteId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /pendingUsers/{pendingUserId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /storeUserBindings/{bindingId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /storeUsers/{bindingId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /counters/orderNumbers {
      allow read: if true;
      allow create: if isAdmin() || (request.resource.data.keys().hasOnly(["qr", "pos"])
        && request.resource.data.qr is number
        && request.resource.data.pos is number);
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["qr", "pos"])
        && request.resource.data.qr is number
        && request.resource.data.pos is number
        && request.resource.data.qr >= resource.data.qr
        && request.resource.data.pos >= resource.data.pos);
      allow delete: if isAdmin();
    }

    match /counters/{counterId} {
      allow read, create, update, delete: if isAdmin();
    }
  }
}
